{
  "name": "pi-workbench",
  "version": "0.13.0",
  "private": true,
  "description": "A polished terminal workbench, theme, and extension suite for Pi.",
  "type": "module",
  "bin": {
    "pi-workbench-install": "./scripts/install-cli.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/amAbdoMo/Pi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amAbdoMo/Pi.git"
  },
  "bugs": {
    "url": "https://github.com/amAbdoMo/Pi/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-theme",
    "terminal-ui",
    "coding-agent",
    "mcp",
    "rtl",
    "subagents"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ]
  },
  "scripts": {
    "browser": "node browser/server.mjs",
    "browser:startup:install": "powershell.exe -NoProfile -File scripts/browser/install-pi-harness-startup.ps1 -Action Install",
    "browser:startup:status": "powershell.exe -NoProfile -File scripts/browser/install-pi-harness-startup.ps1 -Action Status",
    "browser:startup:uninstall": "powershell.exe -NoProfile -File scripts/browser/install-pi-harness-startup.ps1 -Action Uninstall",
    "capture": "node scripts/capture-config.mjs",
    "scan:public": "node scripts/scan-public-files.mjs",
    "scan:browser-security": "node scripts/check-browser-security.mjs",
    "test": "node scripts/validate.mjs && npm run scan:public && npm run scan:browser-security && node --test tests/*.test.mjs && npm run test:workflow",
    "test:node20": "node scripts/test-node20.mjs",
    "test:workflow": "vitest run --config extensions/workflow/vitest.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "arabic-reshaper": "1.1.0",
    "bidi-js": "1.0.3",
    "jsonc-parser": "3.3.1",
    "proper-lockfile": "4.1.2",
    "typebox": "1.1.38",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "vitest": "3.2.7"
  }
}
